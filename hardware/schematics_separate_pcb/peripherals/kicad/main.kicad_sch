	(text "this is the positive edge version of the master reset signal"
		(exclude_from_sim no)
		(at 1134.872 1158.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "25b15e24-340a-4145-9608-cefac6768e3e")
	)
	(text "HEAD LOAD (Option for double-sided version only)\nThis signal line is used either HEAD LOAD or IN USE.\nWhen this signal is low, R/W head loads against the diskette.\nThe set-up time of the solenoid is recuired before using this\nsignal.\nThis signal line responds to the input signal regardless\nof DRIVE SELECT line.\n\nIN USE (Option)\nWhen DRIVE SELECT signal is low, LOW level of this line will\nturn the LED on and HIGH will turn the LED off."
		(exclude_from_sim no)
		(at 1374.902 1046.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2de30385-aee3-4361-8399-924fce591b34")
	)
	(text "select_3"
		(exclude_from_sim no)
		(at 1362.71 1074.674 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3076265a-edc9-4377-b843-f2086ccab68f")
	)
	(text "512kb ram modules.\n8 modules giving a total of 4mb"
		(exclude_from_sim no)
		(at 636.27 768.35 0)
		(effects
			(font
				(size 6.4516 5.4838)
			)
			(justify left bottom)
		)
		(uuid "42e366a6-e71d-49c4-af38-bd9cc7acb802")
	)
	(text "74HCT244 is used here because it recognizes TTL input levels. \nttl levels are lower than CMOS, and the esp works at 3.3V.\nso when a high level is generated by the esp, it will go thru\n the HCT and it will trconize it as a high, whereas a niejjA"
		(exclude_from_sim no)
		(at 1294.13 859.282 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4c3a9305-f8c7-4a59-9298-36d2771ce24a")
	)
	(text "i need to add logic so that uart only activates if ad21 to ad16 are zero\nbecause that is the io area for when paging is on"
		(exclude_from_sim no)
		(at 912.622 1308.862 0)
		(effects
			(font
				(size 5.08 4.318)
			)
			(justify left bottom)
		)
		(uuid "70e891ac-366f-4346-88dd-18cb9281599b")
	)
	(text "SIDE SELECT\nThis signal defines which side of a two-sided diskette to be\nwritten on or read from.\nWhen this signal is LOW, side 1 head is selected, and when\nHIGH, side 0 head is selected. When switching from one side\nto the other, the waiting time is required before read/write\noperation starts."
		(exclude_from_sim no)
		(at 1427.734 1101.598 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7b0cb120-d923-422c-a801-8eee4a2afdf6")
	)
	(text "from wd1770"
		(exclude_from_sim no)
		(at 1409.192 978.154 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "948cf129-dd26-416a-ac1b-8ada7a03df52")
	)
