	(text "halt:\nuse the halt flag to tri-state all buses.\ndo microcode loop to test for interrupts or dma.\nif no interrupts or dma then just perform tight\nloop of zero offset.\nwhen int or dma appears, jump +1.\nnext microinstr is pre-fetch type, so that int\nor dma can be executed.\npc will be pointing to after halt.\ninterrupts should always clear the halt flag,\nso that execution goes normally after the int finished.\nperhaps want not to test for dma because if\ndma happens during halt, then when dma\nis over, execution will continue after halt, which is not what should happen."
		(exclude_from_sim no)
		(at 690.88 1893.57 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "054ebfc7-1f29-457b-a805-cba06f931698")
	)
	(text "this comes from the microcode board\nbut is not a control bit. it is a\ncombination of two bits."
		(exclude_from_sim no)
		(at 1885.95 1473.2 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
