	(text "shl: msb goes into cf. lsb replaced by 0\nsla: same as shl\nrol: lsb becomes msb.\nrlc: msb goes into cf. lsb becomes cf\nshr: lsb goes into cf. msb replaced by 0\nsra: lsb goes into cf. msb is whatever the previous one was\nror: msb becomes lsb\nrrc: msb becomes cf. lsb goes into cf"
		(exclude_from_sim no)
		(at 505.46 2204.72 0)
		(effects
			(font
				(size 3.81 3.2385)
			)
