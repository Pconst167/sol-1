0791   0332 FD 9D 08      shl a, 8               ; only al used, move to ah
0792   0335 19 09         mov al, 09h            ; set rtc month
0793   0337 05 01         syscall sys_rtc        ; set rtc
0794   0339 3B 7B 0E      mov d, s_set_minutes
