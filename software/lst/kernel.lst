0751   02D0 19 01         mov al, 01
0752   02D2 05 01         syscall sys_rtc        ; get minutes
0753   02D4 99            mov bl, ah
0754   02D5 07 15 08      call print_u8x
0755   02D8 10 00 3A      mov a, $3a00  
