0710   027D 22 00         mov ah, 0
0711   027F FD 9D 02      shl a, 2          
0712   0282 3B C3 0E      mov d, s_week
0713   0285 59            add d, a
0714   0286 07 75 07      call _puts
0715   0289 10 00 20      mov a, $2000
0716   028C 05 03         syscall sys_io         ; display ' '
0717   028E 19 04         mov al, 4
0718   0290 05 01         syscall sys_rtc        ; get day
0719   0292 99            mov bl, ah
0720   0293 07 15 08      call print_u8x
0721   0296 10 00 20      mov a, $2000
0722   0299 05 03         syscall sys_io         ; display ' '
0723   029B             ; there is a problem with the month displaying
0724   029B             ; the month is stored as bcd. so when retrieving the month, the value will be in binary
0725   029B             ; even though it is to be understood as bcd.
0726   029B             ; when retrieving the value and adding the string table address offset the value will go overboard!  
0727   029B 19 05         mov al, 05
0728   029D 05 01         syscall sys_rtc        ; get month
0729   029F 1A            mov al, ah
0730   02A0 22 00         mov ah, 0
0731   02A2 FD 9D 02      shl a, 2          
0732   02A5 3B 8F 0E      mov d, s_months
0733   02A8 59            add d, a
0734   02A9 07 75 07      call _puts
0735   02AC 10 00 20      mov a, $2000
0736   02AF 05 03         syscall sys_io         ; display ' '
0737   02B1 2E 20         mov bl, $20
0738   02B3 07 15 08      call print_u8x         ; print 20 for year prefix
0739   02B6 19 06         mov al, 06
0740   02B8 05 01         syscall sys_rtc        ; get year
0741   02BA 99            mov bl, ah
0742   02BB 07 15 08      call print_u8x
0743   02BE 10 00 20      mov a, $2000  
0744   02C1 05 03         syscall sys_io         ; display ' '
0745   02C3 19 02         mov al, 2
0746   02C5 05 01         syscall sys_rtc        ; get hours
0747   02C7 99            mov bl, ah
0748   02C8 07 15 08      call print_u8x
0749   02CB 10 00 3A      mov a, $3a00    
