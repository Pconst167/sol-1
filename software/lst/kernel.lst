0660   023F             
0661   023F             ; ------------------------------------------------------------------------------------------------------------------;
0662   023F             ; real-time clock services syscall
0663   023F             ; rtc i/o bank = ffa0 to ffaf
0664   023F             ; ffa0 to ffa7 is scratch ram
0665   023F             ; control register at $ffa8 [ w | r | s | cal4..cal0 ]
0666   023F             ; al = 0..6 -> get
0667   023F             ; al = 7..d -> set
0668   023F             ; ------------------------------------------------------------------------------------------------------------------;
0669   023F             syscall_rtc:
0670   023F DB            push al
0671   0240 DA            push d
0672   0241 B9 06         cmp al, 6
0673   0243 D1 58 02      jgu syscall_rtc_set
0674   0246             syscall_rtc_get:
0675   0246 6A A9         add al, $a9             ; generate rtc address to get to address a9 of clock
0676   0248 22 FF         mov ah, $ff    
0677   024A 3C            mov d, a                ; get to ffa9 + offset
0678   024B F2 A8 FF 40   mov byte[$ffa8], $40    ; set r bit to 1
0679   024F 1E            mov al, [d]             ; get data
0680   0250 F2 A8 FF 00   mov byte[$ffa8], 0      ; reset r bit
0681   0254 23            mov ah, al
0682   0255 E7            pop d
0683   0256 E8            pop al
0684   0257 06            sysret
0685   0258             syscall_rtc_set:
0686   0258 DD            push bl
0687   0259 99            mov bl, ah              ; set data aside
0688   025A 6A A2         add al, $a2             ; generate rtc address to get to address a9 of clock
0689   025C 22 FF         mov ah, $ff    
0690   025E 3C            mov d, a                ; get to ffa9 + offset
0691   025F 1B            mov al, bl              ; get data back
0692   0260 F2 A8 FF 80   mov byte[$ffa8], $80    ; set w bit to 1
0693   0264 3E            mov [d], al             ; set data
0694   0265 F2 A8 FF 00   mov byte[$ffa8], 0      ; reset write bit
0695   0269 EA            pop bl
0696   026A E7            pop d
0697   026B E8            pop al
0698   026C 06            sysret
0699   026D             
