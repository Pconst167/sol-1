0808   035A             ; ------------------------------------------------------------------------------------------------------------------;
0809   035A             ; ide services syscall
0810   035A             ; al = option
0811   035A             ; 0 = ide reset, 1 = ide sleep, 2 = read sector, 3 = write sector
0812   035A             ; ide read/write sector
0813   035A             ; 512 bytes
0814   035A             ; user buffer pointer in d
0815   035A             ; ah = number of sectors
0816   035A             ; cb = lba bytes 3..0
0817   035A             ; ------------------------------------------------------------------------------------------------------------------;
0818   035A             ide_serv_tbl:
0819   035A 66 03         .dw ide_reset
0820   035C 7A 03         .dw ide_sleep
0821   035E 89 03         .dw ide_read_sect_wrapper
0822   0360 8D 03         .dw ide_write_sect_wrapper
0823   0362             syscall_ide:
0824   0362 FD 0A 5A 03   jmp [ide_serv_tbl + al]    
0825   0366             
0826   0366             ide_reset:      
0827   0366 F2 D7 FF 04   mov byte[_ide_r7], 4            ; reset ide
0828   036A 07 13 04      call ide_wait                   ; wait for ide ready             
0829   036D F2 D6 FF E0   mov byte[_ide_r6], $e0          ; lba3= 0, master, mode= lba        
0830   0371 F2 D1 FF 01   mov byte[_ide_r1], 1            ; 8-bit transfers      
0831   0375 F2 D7 FF EF   mov byte[_ide_r7], $ef          ; set feature command
0832   0379 06            sysret
0833   037A             
0834   037A             ide_sleep:
0835   037A 07 13 04      call ide_wait                   ; wait for ide ready             
0836   037D F2 D6 FF 40   mov byte [_ide_r6], %01000000   ; lba[3:0](reserved), bit 6=1
0837   0381 F2 D7 FF E6   mov byte [_ide_r7], $e6         ; sleep command
0838   0385 07 13 04      call ide_wait                   ; wait for ide ready
0839   0388 06            sysret
0840   0389             
0841   0389             ide_read_sect_wrapper:
0842   0389 07 91 03      call ide_read_sect
0843   038C 06            sysret
0844   038D             ide_write_sect_wrapper:
0845   038D 07 B7 03      call ide_write_sect
0846   0390 06            sysret
0847   0391             
0848   0391             ide_read_sect:
0849   0391 1A            mov al, ah
0850   0392 24            mov ah, bl
0851   0393 42 D2 FF      mov [_ide_r2], a                ; number of sectors (0..255)
0852   0396 1C            mov al, bh
0853   0397 3D D4 FF      mov [_ide_r4], al
0854   039A 12            mov a, c
0855   039B 3D D5 FF      mov [_ide_r5], al
0856   039E 1A            mov al, ah
0857   039F 87 0F         and al, %00001111
0858   03A1 8B E0         or al, %11100000                ; mode lba, master
0859   03A3 3D D6 FF      mov [_ide_r6], al
0860   03A6             ide_read_sect_wait:
0861   03A6 1D D7 FF      mov al, [_ide_r7]  
0862   03A9 87 80         and al, $80                     ; busy flag
0863   03AB C7 A6 03      jnz ide_read_sect_wait
0864   03AE 19 20         mov al, $20
0865   03B0 3D D7 FF      mov [_ide_r7], al               ; read sector cmd
0866   03B3 07 DD 03      call ide_read  
0867   03B6 09            ret
0868   03B7             
0869   03B7             ide_write_sect:
0870   03B7 1A            mov al, ah
0871   03B8 24            mov ah, bl
0872   03B9 42 D2 FF      mov [_ide_r2], a                ; number of sectors (0..255)
0873   03BC 1C            mov al, bh
0874   03BD 3D D4 FF      mov [_ide_r4], al
0875   03C0 12            mov a, c
0876   03C1 3D D5 FF      mov [_ide_r5], al
0877   03C4 1A            mov al, ah
0878   03C5 87 0F         and al, %00001111
0879   03C7 8B E0         or al, %11100000                ; mode lba, master
0880   03C9 3D D6 FF      mov [_ide_r6], al
0881   03CC             ide_write_sect_wait:
0882   03CC 1D D7 FF      mov al, [_ide_r7]  
0883   03CF 87 80         and al, $80                     ; busy flag
0884   03D1 C7 CC 03      jnz ide_write_sect_wait
0885   03D4 19 30         mov al, $30
0886   03D6 3D D7 FF      mov [_ide_r7], al               ; write sector cmd
0887   03D9 07 F8 03      call ide_write      
0888   03DC 09            ret
0889   03DD             
0890   03DD             ;----------------------------------------------------------------------------------------------------;
0891   03DD             ; read ide data
0892   03DD             ; pointer in d
0893   03DD             ;----------------------------------------------------------------------------------------------------;
0894   03DD             ide_read:
0895   03DD DA            push d
0896   03DE             ide_read_loop:
0897   03DE 1D D7 FF      mov al, [_ide_r7]  
0898   03E1 87 80         and al, 80h                     ; busy flag
0899   03E3 C7 DE 03      jnz ide_read_loop               ; wait loop
0900   03E6 1D D7 FF      mov al, [_ide_r7]
0901   03E9 87 08         and al, %00001000               ; drq flag
0902   03EB C6 F6 03      jz ide_read_end
0903   03EE 1D D0 FF      mov al, [_ide_r0]
0904   03F1 3E            mov [d], al
0905   03F2 79            inc d
0906   03F3 0A DE 03      jmp ide_read_loop
0907   03F6             ide_read_end:
0908   03F6 E7            pop d
0909   03F7 09            ret
0910   03F8             
0911   03F8             ;----------------------------------------------------------------------------------------------------;
0912   03F8             ; write ide data
0913   03F8             ; data pointer in d
0914   03F8             ;----------------------------------------------------------------------------------------------------;
0915   03F8             ide_write:
0916   03F8 DA            push d
0917   03F9             ide_write_loop:
0918   03F9 1D D7 FF      mov al, [_ide_r7]  
0919   03FC 87 80         and al, 80h             ; busy flag
0920   03FE C7 F9 03      jnz ide_write_loop      ; wait loop
0921   0401 1D D7 FF      mov al, [_ide_r7]
0922   0404 87 08         and al, %00001000       ; drq flag
0923   0406 C6 11 04      jz ide_write_end
0924   0409 1E            mov al, [d]
0925   040A 3D D0 FF      mov [_ide_r0], al
0926   040D 79            inc d 
0927   040E 0A F9 03      jmp ide_write_loop
0928   0411             ide_write_end:
0929   0411 E7            pop d
0930   0412 09            ret
0931   0413             
0932   0413             ;----------------------------------------------------------------------------------------------------;
0933   0413             ; wait for ide to be ready
0934   0413             ;----------------------------------------------------------------------------------------------------;
0935   0413             ide_wait:
