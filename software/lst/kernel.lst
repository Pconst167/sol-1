0521   015F             ; reboot system
0522   015F             syscall_reboot:
0523   015F FD D7 7F FF   push word _stack_start
0524   0163 FD DB 00      push byte %00000000             ; dma_ack = 0, interrupts disabled, mode = supervisor, paging = off, halt=0, display_reg_load=0, dir=0
0525   0166 FD D7 90 01   push word bios_reset_vector     ; and then push reset vector of the shell to the stack
0526   016A 06            sysret
0527   016B             
0528   016B             
0529   016B             ; ------------------------------------------------------------------------------------------------------------------;
0530   016B             ; exceptions code block
0531   016B             ; ------------------------------------------------------------------------------------------------------------------;
0532   016B             ; privilege exception
0533   016B             ; ------------------------------------------------------------------------------------------------------------------;
0534   016B             trap_privilege:
0535   016B DA            push d
0536   016C 3B CC 0D      mov d, s_priviledge
0537   016F 07 75 07      call _puts
0538   0172 E7            pop d
0539   0173 0A 5F 01      jmp syscall_reboot
0540   0176             
0541   0176             ; ------------------------------------------------------------------------------------------------------------------;
0542   0176             ; breakpoint
0543   0176             ; important: values in the stack are being pushed in big endian. i.e.: msb at low address
0544   0176             ; and lsb at high address. *** need to correct this in the microcode and make it little endian again ***
0545   0176             ; ------------------------------------------------------------------------------------------------------------------;
0546   0176             syscall_break:
0547   0176 4B            pusha
0548   0177             syscall_break_prompt:
0549   0177 3B FE 0D      mov d, s_break1
0550   017A 07 75 07      call _puts
0551   017D 07 22 07      call printnl
0552   0180 07 77 08      call scan_u16d
0553   0183 AF 00 00      cmp a, 0
0554   0186 C6 91 01      je syscall_break_regs
0555   0189 AF 01 00      cmp a, 1
0556   018C C6 B4 01      je syscall_break_mem
0557   018F             syscall_break_end:  
0558   018F 4C            popa
0559   0190 06            sysret
0560   0191             syscall_break_regs:
0561   0191 48            mov a, sp
0562   0192 53 0E 00      add a, 14               ; back-track 7 registers
0563   0195 3C            mov d, a
0564   0196 3A 07         mov cl, 7
0565   0198             syscall_regs_l0:
0566   0198 2A            mov b, [d]
0567   0199 FD AB         swp b
0568   019B 07 D1 07      call print_u16x         ; print register value
0569   019E 07 22 07      call printnl
0570   01A1 63 02 00      sub d, 2
0571   01A4 71 01         sub cl, 1
0572   01A6 C3 00         cmp cl, 0
0573   01A8 C7 98 01      jne syscall_regs_l0
0574   01AB 0A 77 01      jmp syscall_break_prompt
0575   01AE 07 22 07      call printnl
0576   01B1 0A 77 01      jmp syscall_break_prompt
0577   01B4             syscall_break_mem:
0578   01B4 07 22 07      call printnl
0579   01B7 07 F3 07      call scan_u16x
0580   01BA 4D            mov si, a               ; data source from user space
0581   01BB FD 4F 0E 20   mov di, scrap_sector    ; destination in kernel space
0582   01BF 38 00 02      mov c, 512
0583   01C2 04            load                    ; transfer data to kernel space!
0584   01C3 3B 0E 20      mov d, scrap_sector     ; dump pointer in d
0585   01C6 38 00 00      mov c, 0
0586   01C9             dump_loop:
0587   01C9 84            mov al, cl
0588   01CA 87 0F         and al, $0f
0589   01CC C6 1A 02      jz print_base
0590   01CF             back:
0591   01CF 1E            mov al, [d]             ; read byte
0592   01D0 2F            mov bl, al
0593   01D1 07 15 08      call print_u8x
0594   01D4 10 00 20      mov a, $2000
0595   01D7 05 03         syscall sys_io          ; space
0596   01D9 84            mov al, cl
0597   01DA 87 0F         and al, $0f
0598   01DC B9 0F         cmp al, $0f
0599   01DE C6 EF 01      je print_ascii
0600   01E1             back1:
0601   01E1 79            inc d
0602   01E2 78            inc c
0603   01E3 C2 00 02      cmp c, 512
0604   01E6 C7 C9 01      jne dump_loop
0605   01E9 07 22 07      call printnl
0606   01EC 0A 77 01      jmp syscall_break_prompt  ; go to syscall_break return point
0607   01EF             print_ascii:
0608   01EF 10 00 20      mov a, $2000
0609   01F2 05 03         syscall sys_io
0610   01F4 63 10 00      sub d, 16
0611   01F7 26 10 00      mov b, 16
0612   01FA             print_ascii_l:
0613   01FA 79            inc d
0614   01FB 1E            mov al, [d]               ; read byte
0615   01FC B9 20         cmp al, $20
0616   01FE C8 06 02      jlu dot
0617   0201 B9 7E         cmp al, $7e
0618   0203 D0 0E 02      jleu ascii
0619   0206             dot:
0620   0206 10 00 2E      mov a, $2e00
0621   0209 05 03         syscall sys_io
0622   020B 0A 13 02      jmp ascii_continue
0623   020E             ascii:
0624   020E 23            mov ah, al
0625   020F 19 00         mov al, 0
0626   0211 05 03         syscall sys_io
0627   0213             ascii_continue:
0628   0213 FD A9 FA 01   loopb print_ascii_l
0629   0217 0A E1 01      jmp back1
0630   021A             print_base:
0631   021A 07 22 07      call printnl
0632   021D 2D            mov b, d
0633   021E 61 0E 20      sub b, scrap_sector      ; remove this later and fix address bases which display incorrectly
0634   0221 07 D1 07      call print_u16x          ; display row
0635   0224 10 00 3A      mov a, $3a00
0636   0227 05 03         syscall sys_io
0637   0229 10 00 20      mov a, $2000
0638   022C 05 03         syscall sys_io
0639   022E 0A CF 01      jmp back
0640   0231             
0641   0231             ; ------------------------------------------------------------------------------------------------------------------;
0642   0231             ; divide by zero exception
0643   0231             ; ------------------------------------------------------------------------------------------------------------------;
0644   0231             trap_div_zero:
0645   0231 D7            push a
0646   0232 DA            push d
0647   0233 E1            pushf
0648   0234 3B E3 0D      mov d, s_divzero
0649   0237 07 75 07      call _puts
0650   023A EE            popf
0651   023B E7            pop d
0652   023C E4            pop a
0653   023D 06            sysret ; enable interrupts
0654   023E             
