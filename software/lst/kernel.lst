0211   0012             ; total of 7 entries, starting at address $0012
0212   0012             ; ------------------------------------------------------------------------------------------------------------------;
0213   0012 6B 01       .dw trap_privilege
0214   0014 31 02       .dw trap_div_zero
0215   0016 3E 02       .dw trap_undef_opcode
0216   0018 00 00       .dw 0
0217   001A 00 00       .dw 0
0218   001C 00 00       .dw 0
0219   001E 00 00       .dw 0
0220   0020             
0221   0020             ; ------------------------------------------------------------------------------------------------------------------;
0222   0020             ; system call vector table
0223   0020             ; starts at address $0020
0224   0020             ; ------------------------------------------------------------------------------------------------------------------;
0225   0020 76 01       .dw syscall_break
0226   0022 3F 02       .dw syscall_rtc
0227   0024 62 03       .dw syscall_ide
0228   0026 22 04       .dw syscall_io
0229   0028 D9 04       .dw syscall_file
0230   002A 71 02       .dw syscall_datetime
0231   002C 5F 01       .dw syscall_reboot
0232   002E 4D 01       .dw syscall_system
0233   0030 85 00       .dw syscall_fork
0234   0032             
