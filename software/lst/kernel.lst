0959   0426             ; bit7 is the divisor latch access bit (dlab). it must be set high (logic 1) to access the divisor latches
0960   0426             ; of the baud generator during a read or write operation. it must be set low (logic 0) to access the receiver
0961   0426             ; buffer, the transmitter holding register, or the interrupt enable register.
0962   0426             syscall_io_uart_setup:
0963   0426 1D 9E 0C      mov al, [sys_uart0_lcr]
0964   0429 8B 80         or al, $80                ; set dlab access bit
0965   042B 3D 83 FF      mov [_uart0_lcr], al      ; 8 data, 2 stop, even parity 
0966   042E 1D A1 0C      mov al, [sys_uart0_div0]
0967   0431 3D 80 FF      mov [_uart0_dlab_0], al   ; divisor latch byte 0
0968   0434 1D A2 0C      mov al, [sys_uart0_div1]
0969   0437 3D 81 FF      mov [_uart0_dlab_1], al   ; divisor latch byte 1      
0970   043A 1D 9E 0C      mov al, [sys_uart0_lcr]
0971   043D 87 7F         and al, $7f               ; clear dlab access bit 
0972   043F 3D 83 FF      mov [_uart0_lcr], al
0973   0442 1D 9F 0C      mov al, [sys_uart0_inten]
0974   0445 3D 81 FF      mov [_uart0_ier], al      ; interrupts
0975   0448 1D A0 0C      mov al, [sys_uart0_fifoen]
0976   044B 3D 82 FF      mov [_uart0_fcr], al      ; fifo control
0977   044E             
0978   044E             ; uart1:
