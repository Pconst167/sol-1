0266   0032             .export _fdc_stat_cmd     
0267   0032             
0268   0032             ; ------------------------------------------------------------------------------------------------------------------;
0269   0032             ; irqs' code block
0270   0032             ; ------------------------------------------------------------------------------------------------------------------;
0271   0032             ; 5.25" floppy drive controller irq
0272   0032             int_0_fdc:
0273   0032 3B DF 0E      mov d, s_fdc_irq
0274   0035 07 75 07      call _puts
0275   0038 06            sysret
0276   0039             int_1:
0277   0039 06            sysret
0278   003A             int_2:
0279   003A 06            sysret
0280   003B             int_3:
0281   003B 06            sysret
0282   003C             int_4:
0283   003C 06            sysret
0284   003D             
0285   003D             ; ------------------------------------------------------------------------------------------------------------------;
0286   003D             ; uart1 interrupt
0287   003D             ; ------------------------------------------------------------------------------------------------------------------;
0288   003D             int_5_uart1:
0289   003D D7            push a
0290   003E DA            push d
0291   003F E1            pushf
0292   0040 1D 88 FF      mov al, [_uart1_data]       ; get character
0293   0043               ;mov [[d]], al              ; TODO: implement this double indirection instruction
0294   0043 3B A8 0C      mov d, fifo_in
0295   0046 FD 2A         mov d, [d]
0296   0048 3E            mov [d], al                 ; add to fifo
0297   0049 13            mov a, d
0298   004A 77            inc a
0299   004B AF 0E 20      cmp a, fifo + _fifo_size     ; check if pointer reached the end of the fifo
0300   004E C7 54 00      jne int_5_continue
0301   0051 10 0E 10      mov a, fifo  
0302   0054             int_5_continue:  
0303   0054 42 A8 0C      mov [fifo_in], a            ; update fifo pointer
0304   0057 1A            mov al, ah
0305   0058 3D B0 FF      mov [_til311_display], al
0306   005B EE            popf
0307   005C E7            pop d
0308   005D E4            pop a  
0309   005E 06            sysret
0310   005F             
0311   005F             ; ------------------------------------------------------------------------------------------------------------------;
0312   005F             ; timer irq
0313   005F             ; ------------------------------------------------------------------------------------------------------------------;
0314   005F             int_6_timer:  
0315   005F 06            sysret
0316   0060             
0317   0060             ; ------------------------------------------------------------------------------------------------------------------;
0318   0060             ; uart0 interrupt
0319   0060             ; ------------------------------------------------------------------------------------------------------------------;
0320   0060             int_7_uart0:
0321   0060 D7            push a
0322   0061 DA            push d
0323   0062 E1            pushf
0324   0063 1D 80 FF      mov al, [_uart0_data]       ; get character
0325   0066               ;mov [[d]], al              ; TODO: implement this double indirection instruction
0326   0066 3B A8 0C      mov d, fifo_in
0327   0069 FD 2A         mov d, [d]
0328   006B 3E            mov [d], al                 ; add to fifo
0329   006C 13            mov a, d
0330   006D 77            inc a
0331   006E AF 0E 20      cmp a, fifo + _fifo_size     ; check if pointer reached the end of the fifo
0332   0071 C7 77 00      jne int_7_continue
0333   0074 10 0E 10      mov a, fifo  
0334   0077             int_7_continue:  
0335   0077 42 A8 0C      mov [fifo_in], a            ; update fifo pointer
0336   007A 1A            mov al, ah
0337   007B 3D B0 FF      mov [_til311_display], al
0338   007E EE            popf
0339   007F E7            pop d
0340   0080 E4            pop a  
0341   0081 06            sysret
0342   0082             
0343   0082             sys_mkfs:
0344   0082 06            sysret
0345   0083             
0346   0083             ; ------------------------------------------------------------------------------------------------------------------;
0347   0083             ; process syscalls
0348   0083             ; ------------------------------------------------------------------------------------------------------------------;
0349   0083             ; look for empty process slot
0350   0083             ; initialize new process
0351   0083             ; copy old process kernel table entries
0352   0083             ; copy old process image into new one
0353   0083             fork_jmptbl:
0354   0083 89 00         .dw fork
0355   0085             syscall_fork:
0356   0085 FD 0A 83 00   jmp [fork_jmptbl + al]
0357   0089             
0358   0089             fork:
0359   0089 1D 79 0F      mov al, [curr_pid]
0360   008C 22 00         mov ah, 0
0361   008E FD 9D 07      shl a, 7          ; mul by 128
0362   0091 53 8E 0F      add a, proc_table
0363   0094 4D            mov si, a
0364   0095 07 2A 01      call find_empty_proc_slot  ; result proc entry address in a
0365   0098 4F            mov di, a
0366   0099 38 80 00      mov c, 128
0367   009C FD F5         rep movsb  ; copy proc structure from old to new
0368   009E             
0369   009E               ; TODO: need to write better function to allocate new PIDs and check that they are not already used etc
0370   009E 3C            mov d, a  ; new process entry base
0371   009F 1D 77 0F      mov al, [pid_counter]
0372   00A2 3E            mov [d], al   ; set new PID
0373   00A3 DB            push al  ; save new process PID for using below
0374   00A4 07 16 01      call proc_memory_map  ; allocate ram for new process in page table
0375   00A7 1D 77 0F      mov al, [pid_counter] ; proc_memory_map overwrites al, so get it again
0376   00AA 7A            inc al
0377   00AB 3D 77 0F      mov [pid_counter], al ; update global pid counter
0378   00AE             
0379   00AE 1D 79 0F      mov al, [curr_pid]
0380   00B1 3F 01 00      mov [d + 1], al ; set parent pid
0381   00B4 19 01         mov al, proc_runnable
0382   00B6 3F 02 00      mov [d + 2], al ; set process as runnable
0383   00B9             
0384   00B9               ; the offset of the register context is 69
0385   00B9               ; for parent the return value in AL is the child's PID
0386   00B9               ; and for the child the return value in AL is 0
0387   00B9               ; so we need to place 0 in the AL register in the new process' context block
0388   00B9 19 00         mov al, 0
0389   00BB 3F 45 00      mov [d + 69], al  ; child PID return value = 0
0390   00BE             
0391   00BE               ; obtain parent(current) process' entry offset again
0392   00BE 1D 79 0F      mov al, [curr_pid]
0393   00C1 22 00         mov ah, 0
0394   00C3 FD 9D 07      shl a, 7  ; mul by 128
0395   00C6 53 8E 0F      add a, proc_table
0396   00C9 3C            mov d, a
0397   00CA E8            pop al   ; retrieve new child process PID that we obained before
0398   00CB 3F 45 00      mov [d + 69], al  ; and now copy that child PID into the parent's context's return value in A register
0399   00CE             
0400   00CE               ; now copy the entire parent's code image into the child's
0401   00CE 2F            mov bl, al
0402   00CF 07 D3 00      call fork_image_copy
0403   00D2             
0404   00D2 06            sysret
0405   00D3             
0406   00D3             ; copy entire image from one process to another
0407   00D3             ; bl: new proc PID
0408   00D3             ; curr_pid: origin process
0409   00D3             fork_image_copy:
0410   00D3 B8 7C 0F 00   mov word[tmp_si], 0
0410   00D7 00 
0411   00D8 B8 7A 0F 00   mov word[tmp_di], 0
0411   00DC 00 
0412   00DD 38 00 00      mov c, 0
0413   00E0             fork_image_copy_l0:
0414   00E0 D9            push c
0415   00E1 1D 79 0F      mov al, [curr_pid]
0416   00E4 01            setptb ; set page table base to curr_proc PID
0417   00E5 14 7C 0F      mov a, [tmp_si]
0418   00E8 4D            mov si, a
0419   00E9 FD 4F 0E 22   mov di, transient_area
0420   00ED 38 00 08      mov c, 2048
0421   00F0 04            load    ; copy one page
0422   00F1 D3 00 08      add si, 2048
0423   00F4 4E            mov a, si
0424   00F5 42 7C 0F      mov [tmp_si], a
0425   00F8             
0426   00F8 1B            mov al, bl
0427   00F9 01            setptb ; set page table base to new proc PID
0428   00FA FD 4D 0E 22   mov si, transient_area
0429   00FE 14 7A 0F      mov a, [tmp_di]
0430   0101 4F            mov di, a
0431   0102 38 00 08      mov c, 2048
0432   0105 03            store
0433   0106 D4 00 08      add di, 2048
0434   0109 50            mov a, di
0435   010A 42 7A 0F      mov [tmp_di], a
0436   010D             
0437   010D E6            pop c
0438   010E 78            inc c
0439   010F C2 20 00      cmp c, 32
0440   0112 C7 E0 00      jne fork_image_copy_l0
0441   0115             
0442   0115 09            ret
0443   0116             
0444   0116             ;----------------------------------------------------------------------------------------------------;
0445   0116             ; process index in al
0446   0116             ;----------------------------------------------------------------------------------------------------;
0447   0116             ; 32 pages of 2kb = 64kb
0448   0116             ; bl = ptb
0449   0116             ; bh = page number (5bits)
0450   0116             ; a = physical address
0451   0116             ; bl = proc pid
0452   0116             ; bh(ms 5 bits) = 0 to 31
0453   0116             ; a = 0000_1000_000_00000
0454   0116             proc_memory_map:
0455   0116 22 00         mov ah, 0
0456   0118 27            mov b, a                      ; page in bl, 0 in bh
0457   0119 FD 9D 05      shl a, 5                      ; multiply by 32
0458   011C 39            mov c, a                      ; save in c
0459   011D 57 20 00      add c, 32
0460   0120             proc_memory_map_l0:
0461   0120 02            pagemap
0462   0121 55 00 08      add b, $0800                  ; increase page number (msb 5 bits of bh only)
0463   0124 77            inc a                         ; increase both 
0464   0125 B1            cmp a, c                      ; check to see if we reached the end of memory
0465   0126 C7 20 01      jne proc_memory_map_l0
0466   0129 09            ret
0467   012A             
0468   012A             ; pid, parent_pid, state, fd_table, tty pointer, context (general regs + flags), 38 bytes padding to reach 128
0469   012A             ; return index in b
0470   012A             ; address in a
0471   012A             find_empty_proc_slot:
0472   012A 3B 8E 0F      mov d, proc_table
0473   012D 26 00 00      mov b, 0
0474   0130             find_empty_proc_slot_l0:
0475   0130 1E            mov al, [d]
0476   0131 B9 00         cmp al, 0
0477   0133 C6 41 01      je find_empty_proc_slot_ret
0478   0136 58 80 00      add d, 128
0479   0139 FD 77         inc b
0480   013B C0 80 00      cmp b, _max_user_proc  ; if we go past _max_user_proc (128) that is considered an error
0481   013E C7 30 01      jne find_empty_proc_slot_l0
0482   0141             find_empty_proc_slot_ret:
0483   0141 13            mov a, d
0484   0142 09            ret  ; return in 'bl'
0485   0143             
