0490   0143 57 01         .dw system_uname
0491   0145 5E 01         .dw system_whoami
0492   0147 53 01         .dw system_poke
0493   0149 56 01         .dw system_bootloader_install
0494   014B 51 01         .dw system_peek
0495   014D             syscall_system:
0496   014D FD 0A 43 01   jmp [system_jmptbl + al]
0497   0151             
0498   0151             ; param register address in register d
0499   0151             ; param value in register bl
0500   0151             system_peek:
0501   0151 32            mov bl, [d]
0502   0152 06            sysret
0503   0153             
0504   0153             ; param register address in register d
0505   0153             ; param value in register bl
0506   0153             system_poke:
0507   0153 FD 3E         mov [d], bl
0508   0155 06            sysret
0509   0156             
0510   0156             system_bootloader_install:
0511   0156 06            sysret
0512   0157             
