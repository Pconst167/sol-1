0779   0312 FD 9D 08      shl a, 8               ; only al used, move to ah
0780   0315 19 0B         mov al, 0bh            ; set rtc month
0781   0317 05 01         syscall sys_rtc        ; set rtc
0782   0319 3B 69 0E      mov d, s_set_week
0783   031C 07 75 07      call _puts
