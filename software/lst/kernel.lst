0757   02DD 19 00         mov al, 0
0758   02DF 05 01         syscall sys_rtc        ; get seconds
0759   02E1 99            mov bl, ah
0760   02E2 07 15 08      call print_u8x
0761   02E5 07 22 07      call printnl
0762   02E8 06            sysret
