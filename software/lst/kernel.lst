0773   0302 FD 9D 08      shl a, 8               ; only al used, move to ah
0774   0305 19 0C         mov al, 0ch            ; set rtc month
0775   0307 05 01         syscall sys_rtc        ; set rtc
0776   0309 3B 63 0E      mov d, s_set_day
