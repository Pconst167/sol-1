0001   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0002   0000             ; 74 series minicomputer bios version 1.0
0003   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0004   0000             
0005   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0006   0000             ; memory map
0007   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0008   0000             ; 0000    rom begin
0009   0000             ; ....
0010   0000             ; 7fff    rom end
0011   0000             ;
0012   0000             ; 8000    ram begin
0013   0000             ; ....
0014   0000             ; ff7f    stack root
0015   0000             
0016   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0017   0000             ; i/o map
0018   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0019   0000             ; ff80 - uart 0 (16550)
0020   0000             ; ff88 - uart 1 (16550)
0021   0000             ; ffa0 - rtc    (m48t02)
0022   0000             ; ffb0 - pio 0  (8255)
0023   0000             ; ffc0 - fdd    (5.25" floppy drive block)
0024   0000             ;   - ffc0      output port (377 flip-flop)                  
0025   0000             ;   - ffc1      input port  (244 buffer)                     
0026   0000             ;   - ffc8      wd1770 status/command    
0027   0000             ;   - ffc9      wd1770 track register
0028   0000             ;   - ffca      wd1770 sector register
0029   0000             ;   - ffcb      wd1770 data register
0030   0000             ;      
0031   0000             ; ffd0 - ide    (compact flash / pata)
0032   0000             ; ffe0 - timer  (8253)
0033   0000             ; fff0 - bios configuration nv-ram store area
0034   0000             
0035   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0036   0000             ; system constants / equations
0037   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0038   0000             _uart0_data      .equ $ff80        		 ; data
0039   0000             _uart0_dlab_0    .equ $ff80        		 ; divisor latch low byte
0040   0000             _uart0_dlab_1    .equ $ff81        		 ; divisor latch high byte
0041   0000             _uart0_ier       .equ $ff81        		 ; interrupt enable register
0042   0000             _uart0_fcr       .equ $ff82        		 ; fifo control register
0043   0000             _uart0_lcr       .equ $ff83        		 ; line control register
0044   0000             _uart0_lsr       .equ $ff85        		 ; line status register
0045   0000             
0046   0000             _ide_base        .equ $ffd0        		 ; ide base
0047   0000             _ide_r0          .equ _ide_base + 0    ; data port
0048   0000             _ide_r1          .equ _ide_base + 1    ; read: error code, write: feature
0049   0000             _ide_r2          .equ _ide_base + 2    ; number of sectors to transfer
0050   0000             _ide_r3          .equ _ide_base + 3    ; sector address lba 0 [0:7]
0051   0000             _ide_r4          .equ _ide_base + 4    ; sector address lba 1 [8:15]
0052   0000             _ide_r5          .equ _ide_base + 5    ; sector address lba 2 [16:23]
0053   0000             _ide_r6          .equ _ide_base + 6    ; sector address lba 3 [24:27 (lsb)]
0054   0000             _ide_r7          .equ _ide_base + 7    ; read: status, write: command
0055   0000             
0056   0000             _7seg_display    .equ $ffb0        		 ; bios post code hex display (2 digits)
0057   0000             _bios_post_ctrl  .equ $ffb3        		 ; bios post display control register, 80h = as output
0058   0000             _pio_a           .equ $ffb0    
0059   0000             _pio_b           .equ $ffb1
0060   0000             _pio_c           .equ $ffb2
0061   0000             _pio_control     .equ $ffb3        		 ; pio control port
0062   0000             
0063   0000             _timer_c_0       .equ $ffe0        		 ; timer counter 0
0064   0000             _timer_c_1       .equ $ffe1        		 ; timer counter 1
0065   0000             _timer_c_2       .equ $ffe2        		 ; timer counter 2
0066   0000             _timer_ctrl      .equ $ffe3        		 ; timer control register
0067   0000             
0068   0000             _stack_start     .equ $ff7f       		 ; beginning of stack
0069   0000             _ram_start       .equ $8000       		 ; start of ram memory
0070   0000             
0071   0000             
0072   0000             boot_origin:     .equ _ram_start + 2 + 2  ; TODO: remove these extra 4 bytes when new kernel ready (this is used by old disks)
0073   0000             ide_buffer:      .equ boot_origin + 1024
0074   0000             inode_buffer:    .equ ide_buffer + 2048
0075   0000             
0076   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0077   0000             ; global system variables
0078   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0079   0000             
0080   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0081   0000             ; external interrupt table
0082   0000             ; highest priority at lowest address
0083   0000             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0084   0000 34 00       .dw int_0
0085   0002 35 00       .dw int_1
0086   0004 36 00       .dw int_2
0087   0006 37 00       .dw int_3
0088   0008 38 00       .dw int_4
0089   000A 39 00       .dw int_5
0090   000C 3A 00       .dw int_6
0091   000E 3B 00       .dw int_7
0092   0010             
0093   0010             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0094   0010             ; reset vector declaration
0095   0010             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0096   0010 90 01       .dw bios_reset_vector
0097   0012             
0098   0012             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0099   0012             ;; exception vector table
0100   0012             ;; total of 7 entries, starting at address $0012
0101   0012             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0102   0012 3C 00       .dw trap_privilege  
0103   0014 52 00       .dw trap_div_zero  
0104   0016 5F 00       .dw undefined_opcode
0105   0018 00 00       .dw 0
0106   001A 00 00       .dw 0
0107   001C 00 00       .dw 0
0108   001E 00 00       .dw 0
0109   0020             
0110   0020             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0111   0020             ;; system call vector table
0112   0020             ;; starts at address $0020
0113   0020             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0114   0020 45 00       .dw trap_breakpoint
0115   0022 60 00       .dw rtc_services        
0116   0024 96 00       .dw uart_services        
0117   0026 EE 00       .dw ide_services  
0118   0028 00 00       .dw 0
0119   002A 00 00       .dw 0
0120   002C 00 00       .dw 0
0121   002E 00 00       .dw 0
0122   0030 00 00       .dw 0
0123   0032 00 00       .dw 0  
0124   0034             
0125   0034             bios_bkpt  .equ 0
0126   0034             bios_rtc   .equ 1
0127   0034             bios_uart  .equ 2
0128   0034             bios_ide   .equ 3
0129   0034             
0130   0034             .export _ram_start
0131   0034             .export _stack_start
0132   0034             .export bios_reset_vector
0133   0034             .export ide_buffer
0134   0034             .export inode_buffer
0135   0034             .export boot_origin
0136   0034             .export bios_uart
0137   0034             .export bios_ide
0138   0034             .export __puts
0139   0034             .export __print_u16d
0140   0034             .export __print_u16x
0141   0034             .export __xput_u8
0142   0034             
0143   0034             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0144   0034             ; external interrupts' code block
0145   0034             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0146   0034             int_0:
0147   0034 06            sysret
0148   0035             int_1:
0149   0035 06            sysret
0150   0036             int_2:
0151   0036 06            sysret
0152   0037             int_3:
0153   0037 06            sysret
0154   0038             int_4:
0155   0038 06            sysret
0156   0039             int_5:
0157   0039 06            sysret
0158   003A             int_6:  
0159   003A 06            sysret
0160   003B             int_7:
0161   003B 06            sysret
0162   003C             
0163   003C             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0164   003C             ; exceptions
0165   003C             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0166   003C             
0167   003C             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0168   003C             ; privilege exception
0169   003C             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0170   003C             trap_privilege:
0171   003C DA            push d
0172   003D 3B B7 05      mov d, s_priv1
0173   0040 07 8C 02      call __puts
0174   0043 E7            pop d
0175   0044                           ; enable interrupts
0176   0044 06            sysret
0177   0045             
0178   0045             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0179   0045             ; breakpoint exception
0180   0045             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0181   0045             trap_breakpoint:
0182   0045 D7            push a
0183   0046 DA            push d
0184   0047 E1            pushf
0185   0048               
0186   0048 3B 9F 05      mov d, s_bkpt
0187   004B 07 8C 02      call __puts
0188   004E               
0189   004E EE            popf
0190   004F E7            pop d
0191   0050 E4            pop a
0192   0051                           ; enable interrupts
0193   0051 06            sysret
0194   0052             
0195   0052             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0196   0052             ; divide by zero exception
0197   0052             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0198   0052             trap_div_zero:
0199   0052 D7            push a
0200   0053 DA            push d
0201   0054 E1            pushf
0202   0055               
0203   0055 3B FF 05      mov d, s_divzero
0204   0058 07 8C 02      call __puts
0205   005B               
0206   005B EE            popf
0207   005C E7            pop d
0208   005D E4            pop a
0209   005E                           ; enable interrupts
0210   005E 06            sysret
0211   005F             
0212   005F             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0213   005F             ; undefined opcode exception
0214   005F             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0215   005F             undefined_opcode:
0216   005F 06            sysret
0217   0060               
0218   0060             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0219   0060             ; rtc services interrupt
0220   0060             ; rtc i/o bank = ffa0 to ffaf
0221   0060             ; ffa0 to ffa7 is scratch ram
0222   0060             ; control register at $ffa8 [ w | r | s | cal4..cal0 ]
0223   0060             ; al = 0..6 -> get
0224   0060             ; al = 7..d -> set
0225   0060             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0226   0060             rtc_services:
0227   0060 DB            push al
0228   0061 DA            push d
0229   0062 B9 06         cmp al, 6
0230   0064 D1 79 00      jgu rtc_set
0231   0067             rtc_get:
0232   0067 6A A9         add al, $a9      ; generate rtc address to get to address a9 of clock
0233   0069 22 FF         mov ah, $ff    
0234   006B 3C            mov d, a        ; get to ffa9 + offset
0235   006C F2 A8 FF 40   mov byte[$ffa8], $40    ; set r bit to 1
0236   0070 1E            mov al, [d]      ; get data
0237   0071 F2 A8 FF 00   mov byte[$ffa8], 0    ; reset r bit
0238   0075 23            mov ah, al
0239   0076 E7            pop d
0240   0077 E8            pop al
0241   0078 06            sysret
0242   0079             rtc_set:
0243   0079 DD            push bl
0244   007A 99            mov bl, ah    ; set data aside
0245   007B 6A A2         add al, $a2    ; generate rtc address to get to address a9 of clock
0246   007D 22 FF         mov ah, $ff    
0247   007F 3C            mov d, a    ; get to ffa9 + offset
0248   0080 1B            mov al, bl    ; get data back
0249   0081 F2 A8 FF 80   mov byte[$ffa8], $80  ; set w bit to 1
0250   0085 3E            mov [d], al    ; set data
0251   0086 F2 A8 FF 00   mov byte[$ffa8], 0    ; reset write bit
0252   008A EA            pop bl
0253   008B E7            pop d
0254   008C E8            pop al
0255   008D 06            sysret
0256   008E             
0257   008E             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0258   008E             ; int 4
0259   008E             ; uart services interrupt
0260   008E             ; al = option
0261   008E             ; ah = data
0262   008E             ; 0 = init, 1 = send, 2 = receive, 3 = receive with echo
0263   008E             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0264   008E             uart_serv_tbl:
0265   008E 9A 00         .dw uart_init
0266   0090 B3 00         .dw uart_send
0267   0092 C0 00         .dw uart_receive
0268   0094 CD 00         .dw uart_receive_e
0269   0096             uart_services:
0270   0096 FD 0A 8E 00   jmp [uart_serv_tbl + al]
0271   009A             
0272   009A             uart_init:
0273   009A F2 83 FF 8F   mov byte[_uart0_lcr], %10001111      ; 8 data, 2 stop, even parity, divisor latch = 1, uart address 3 = line control register
0274   009E F2 80 FF 03   mov byte[_uart0_dlab_0], 3      ; baud = 38400
0275   00A2 F2 81 FF 00   mov byte[_uart0_dlab_1], 0      ; divisor latch high byte = 0      
0276   00A6 F2 83 FF 0F   mov byte[_uart0_lcr], %00001111      ; divisor latch = 0, uart address 3 = line control register
0277   00AA F2 81 FF 00   mov byte[_uart0_ier], 0      ; disable all uart interrupts
0278   00AE F2 82 FF 00   mov byte[_uart0_fcr], 0      ; disable fifo
0279   00B2 06            sysret
0280   00B3             
0281   00B3             uart_send:
0282   00B3 1D 85 FF      mov al, [_uart0_lsr]      ; read line status register
0283   00B6 93 20         test al, $20          ; isolate transmitter empty
0284   00B8 C6 B3 00      jz uart_send    
0285   00BB 1A            mov al, ah
0286   00BC 3D 80 FF      mov [_uart0_data], al      ; write char to transmitter holding register
0287   00BF 06            sysret
0288   00C0             
0289   00C0             uart_receive:
0290   00C0 1D 85 FF      mov al, [_uart0_lsr]      ; read line status register
0291   00C3 93 01         test al, 1          ; isolate data ready
0292   00C5 C6 C0 00      jz uart_receive
0293   00C8 1D 80 FF      mov al, [_uart0_data]      ; get character
0294   00CB 23            mov ah, al
0295   00CC 06            sysret
0296   00CD             
0297   00CD             uart_receive_e:
0298   00CD 1D 85 FF      mov al, [_uart0_lsr]      ; read line status register
0299   00D0 93 01         test al, 1          ; isolate data ready
0300   00D2 C6 CD 00      jz uart_receive_e
0301   00D5 1D 80 FF      mov al, [_uart0_data]      ; get character
0302   00D8 23            mov ah, al
0303   00D9             uart_receive_e_loop:
0304   00D9 1D 85 FF      mov al, [_uart0_lsr]      ; read line status register
0305   00DC 93 20         test al, $20          ; isolate transmitter empty
0306   00DE C6 D9 00      jz uart_receive_e_loop
0307   00E1 1A            mov al, ah
0308   00E2 3D 80 FF      mov [_uart0_data], al      ; write char to transmitter holding register
0309   00E5 06            sysret
0310   00E6               
0311   00E6             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0312   00E6             ; ide services interrupt
0313   00E6             ; al = option
0314   00E6             ; 0 = ide reset, 1 = ide sleep, 2 = read sector, 3 = write sector
0315   00E6             ; ide read/write sector
0316   00E6             ; 512 bytes
0317   00E6             ; user buffer pointer in d
0318   00E6             ; kernel buffer pointer = ide_buffer
0319   00E6             ; ah = number of sectors
0320   00E6             ; cb = lba bytes 3..0
0321   00E6             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0322   00E6             ide_serv_tbl:
0323   00E6 F2 00         .dw ide_reset
0324   00E8 06 01         .dw ide_sleep
0325   00EA 15 01         .dw ide_read_sect
0326   00EC 36 01         .dw ide_write_sect
0327   00EE             ide_services:
0328   00EE FD 0A E6 00   jmp [ide_serv_tbl + al]  
0329   00F2             ide_reset:      
0330   00F2 F2 D7 FF 04   mov byte[_ide_r7], 4    ; reset ide
0331   00F6 07 87 01      call ide_wait        ; wait for ide ready             
0332   00F9 F2 D6 FF E0   mov byte[_ide_r6], $e0    ; lba3= 0, master, mode= lba        
0333   00FD F2 D1 FF 01   mov byte[_ide_r1], 1    ; 8-bit transfers      
0334   0101 F2 D7 FF EF   mov byte[_ide_r7], $ef    ; set feature command
0335   0105 06            sysret
0336   0106             ide_sleep:
0337   0106 07 87 01      call ide_wait          ; wait for ide ready             
0338   0109 F2 D6 FF 40   mov byte [_ide_r6], %01000000  ; lba[3:0](reserved), bit 6=1
0339   010D F2 D7 FF E6   mov byte [_ide_r7], $e6    ; sleep command
0340   0111 07 87 01      call ide_wait          ; wait for ide ready
0341   0114 06            sysret
0342   0115             ide_read_sect:
0343   0115 1A            mov al, ah
0344   0116 24            mov ah, bl
0345   0117 42 D2 FF      mov [_ide_r2], a      ; number of sectors (0..255)
0346   011A 1C            mov al, bh
0347   011B 3D D4 FF      mov [_ide_r4], al
0348   011E 12            mov a, c
0349   011F 3D D5 FF      mov [_ide_r5], al
0350   0122 1A            mov al, ah
0351   0123 87 0F         and al, %00001111
0352   0125 8B E0         or al, %11100000      ; mode lba, master
0353   0127 3D D6 FF      mov [_ide_r6], al
0354   012A 07 87 01      call ide_wait
0355   012D 19 20         mov al, $20
0356   012F 3D D7 FF      mov [_ide_r7], al      ; read sector cmd
0357   0132 07 57 01      call ide_read  
0358   0135 06            sysret
0359   0136             ide_write_sect:
0360   0136 1A            mov al, ah
0361   0137 24            mov ah, bl
0362   0138 42 D2 FF      mov [_ide_r2], a      ; number of sectors (0..255)
0363   013B 1C            mov al, bh
0364   013C 3D D4 FF      mov [_ide_r4], al
0365   013F 12            mov a, c
0366   0140 3D D5 FF      mov [_ide_r5], al
0367   0143 1A            mov al, ah
0368   0144 87 0F         and al, %00001111
0369   0146 8B E0         or al, %11100000      ; mode lba, master
0370   0148 3D D6 FF      mov [_ide_r6], al
0371   014B 07 87 01      call ide_wait
0372   014E 19 30         mov al, $30
0373   0150 3D D7 FF      mov [_ide_r7], al      ; write sector cmd
0374   0153 07 6F 01      call ide_write      
0375   0156 06            sysret
0376   0157             
0377   0157             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0378   0157             ; read ide data
0379   0157             ; pointer in d
0380   0157             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0381   0157             ide_read:
0382   0157 DB            push al
0383   0158 DA            push d
0384   0159             ide_read_loop:
0385   0159 07 87 01      call ide_wait
0386   015C 1D D7 FF      mov al, [_ide_r7]
0387   015F 87 08         and al, %00001000      ; drq flag
0388   0161 C6 6C 01      jz ide_read_end
0389   0164 1D D0 FF      mov al, [_ide_r0]
0390   0167 3E            mov [d], al
0391   0168 79            inc d
0392   0169 0A 59 01      jmp ide_read_loop
0393   016C             ide_read_end:
0394   016C E7            pop d
0395   016D E8            pop al
0396   016E 09            ret
0397   016F             
0398   016F             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0399   016F             ; write ide data
0400   016F             ; data pointer in d
0401   016F             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0402   016F             ide_write:
0403   016F DB            push al
0404   0170 DA            push d
0405   0171             ide_write_loop:
0406   0171 07 87 01      call ide_wait
0407   0174 1D D7 FF      mov al, [_ide_r7]
0408   0177 87 08         and al, %00001000      ; drq flag
0409   0179 C6 84 01      jz ide_write_end
0410   017C 1E            mov al, [d]
0411   017D 3D D0 FF      mov [_ide_r0], al
0412   0180 79            inc d 
0413   0181 0A 71 01      jmp ide_write_loop
0414   0184             ide_write_end:
0415   0184 E7            pop d
0416   0185 E8            pop al
0417   0186 09            ret
0418   0187             
0419   0187             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0420   0187             ; wait for ide to be ready
0421   0187             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0422   0187             ide_wait:
0423   0187 1D D7 FF      mov al, [_ide_r7]  
0424   018A 87 80         and al, $80        ; busy flag
0425   018C C7 87 01      jnz ide_wait
0426   018F 09            ret
0427   0190             
0428   0190             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0429   0190             ; bios entry point
0430   0190             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0431   0190             bios_reset_vector:
0432   0190 19 00         mov al, %00000000        ; interrupts = off, mode = sup, paging = off, halt-flag = off, display_load = on
0433   0192 0D            stostat
0434   0193               
0435   0193 10 7F FF      mov a, _stack_start
0436   0196 47            mov sp, a
0437   0197 49            mov bp, a      ; setup stack and frame
0438   0198             
0439   0198 19 00         mov al, 0
0440   019A 05 02         syscall bios_uart
0441   019C               
0442   019C 3B F7 03      mov d, s_welcome
0443   019F 07 8C 02      call __puts          ; print welcome msg
0444   01A2             
0445   01A2 0A F9 01      jmp system_test
0446   01A5             system_test_back:
0447   01A5             
0448   01A5 07 C5 01      call bios_peripherals_setup
0449   01A8               
0450   01A8 3B 3E 04      mov d, s_boot1
0451   01AB 07 8C 02      call __puts
