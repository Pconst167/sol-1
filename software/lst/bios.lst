0752   0344             ; CONVERT ASCII 'O'..'F' TO INTEGER 0..15
0753   0344             ; ASCII in BL
0754   0344             ; result in AL
0755   0344             ; ascii for F = 0100 0110
0756   0344             ; ascii for 9 = 0011 1001
0757   0344             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0758   0344             hex_ascii_encode:
0759   0344 1B            mov al, bl  
0760   0345 93 40         test al, 40h        ; test if letter or number
0761   0347 C7 4D 03      jnz hex_letter
0762   034A 87 0F         and al, 0Fh        ; get number
0763   034C 09            ret
0764   034D             hex_letter:
0765   034D DC            push ah
0766   034E 24            mov ah, bl
0767   034F 07 A8 03      call _to_upper
0768   0352 1A            mov al, ah  
0769   0353 87 0F         and al, 0Fh        ; get letter
0770   0355 6A 09         add al, 9
0771   0357 E9            pop ah
0772   0358 09            ret
0773   0359             
0774   0359             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0775   0359             ; ATOI
0776   0359             ; 2 letter hex string in B
0777   0359             ; 8bit integer returned in AL
0778   0359             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0779   0359             _atoi:
0780   0359 E1            pushf
0781   035A D8            push b
0782   035B                 
0783   035B 07 44 03      call hex_ascii_encode      ; convert BL to 4bit code in AL
0784   035E 30            mov bl, bh
0785   035F DB            push al          ; save a
0786   0360 07 44 03      call hex_ascii_encode
0787   0363 EA            pop bl  
0788   0364 FD 9E 04      shl al, 4
0789   0367 8C            or al, bl
0790   0368               
0791   0368 E5            pop b
0792   0369 EE            popf
0793   036A 09            ret  
0794   036B             
0795   036B             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0796   036B             ; ITOA
0797   036B             ; 8bit value in BL
0798   036B             ; 2 byte ASCII result in A
0799   036B             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0800   036B             _itoa:
0801   036B E1            pushf
0802   036C DA            push d
0803   036D DE            push bh
0804   036E DD            push bl
0805   036F             
0806   036F A7 00         mov bh, 0
0807   0371               
0808   0371 FD 87 0F      and bl, $0F
0809   0374 3B 8F 05      mov d, s_hex_digits
0810   0377 5A            add d, b
0811   0378 1E            mov al, [d]        ; get ASCII
0812   0379 EA            pop bl
0813   037A 52 01 00      sub sp, 1        ; push bl back
0814   037D DB            push al
0815   037E               
0816   037E FD 87 F0      and bl, $F0
0817   0381 FD A4 04      shr bl, 4
0818   0384 3B 8F 05      mov d, s_hex_digits
0819   0387 5A            add d, b
0820   0388 1E            mov al, [d]        ; get ASCII
0821   0389             
0822   0389 23            mov ah, al
0823   038A E8            pop al  
0824   038B               
0825   038B EA            pop bl
0826   038C EB            pop bh
0827   038D E7            pop d
0828   038E EE            popf
0829   038F 09            ret
