0832   0390             ; STRCMP
0833   0390             ; compare two strings
0834   0390             ; str1 in SI
0835   0390             ; str2 in DI
0836   0390             ; changes: AL SI DI
0837   0390             ; CREATE A STRING COMPAIRON INSTRUCION ?????
0838   0390             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0839   0390             _strcmp:
0840   0390             _strcmp_loop:
0841   0390 F3            cmpsb          ; compare a byte of the strings
0842   0391 C7 9D 03      jne _strcmp_ret
0843   0394 FB FF FF      lea d, [si + -1]
0844   0397 1E            mov al, [d]
0845   0398 B9 00         cmp al, 0        ; check if at end of string (null)
0846   039A C7 90 03      jne _strcmp_loop        ; equal chars but not at end
0847   039D             _strcmp_ret:        
0848   039D 09            ret
0849   039E             
0850   039E             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0851   039E             ; TO LOWER
