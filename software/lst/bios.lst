0654   02BA             _gets:
0655   02BA E1            pushf
0656   02BB D7            push a
0657   02BC DA            push d
0658   02BD             _gets_loop:
0659   02BD 19 02         mov al, 2
0660   02BF 05 02         syscall bios_uart      ; receive in ah
0661   02C1 76 0A         cmp ah, 0ah        ; lf
0662   02C3 C6 F8 02      je _gets_end
0663   02C6 76 0D         cmp ah, 0dh        ; cr
0664   02C8 C6 F8 02      je _gets_end
0665   02CB 76 5C         cmp ah, $5c        ; '\\'
0666   02CD C6 D6 02      je _gets_escape
0667   02D0 1A            mov al, ah
0668   02D1 3E            mov [d], al
0669   02D2 79            inc d
0670   02D3 0A BD 02      jmp _gets_loop
0671   02D6             _gets_escape:
0672   02D6 19 02         mov al, 2
0673   02D8 05 02         syscall bios_uart      ; receive in ah
0674   02DA 76 6E         cmp ah, 'n'
0675   02DC C6 EA 02      je _gets_lf
0676   02DF 76 72         cmp ah, 'r'
0677   02E1 C6 F1 02      je _gets_cr
0678   02E4 1A            mov al, ah        ; if not a known escape, it is just a normal letter
0679   02E5 3E            mov [d], al
0680   02E6 79            inc d
0681   02E7 0A BD 02      jmp _gets_loop
0682   02EA             _gets_lf:
0683   02EA 19 0A         mov al, $0a
0684   02EC 3E            mov [d], al
0685   02ED 79            inc d
0686   02EE 0A BD 02      jmp _gets_loop
0687   02F1             _gets_cr:
0688   02F1 19 0D         mov al, $0d
0689   02F3 3E            mov [d], al
0690   02F4 79            inc d
0691   02F5 0A BD 02      jmp _gets_loop
