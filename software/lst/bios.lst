0884   03B3             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0885   03B3             ; print 16bit decimal number
0886   03B3             ; input number in a
0887   03B3             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0888   03B3             __print_u16d:
0889   03B3 D7            push a
0890   03B4 D8            push b
0891   03B5 FD D8         push g
0892   03B7 26 10 27      mov b, 10000
0893   03BA AE            div a, b      ; get 10000's coeff.
0894   03BB 07 DF 03      call print_number
0895   03BE 11            mov a, b
0896   03BF 26 E8 03      mov b, 1000
0897   03C2 AE            div a, b      ; get 1000's coeff.
0898   03C3 07 DF 03      call print_number
0899   03C6 11            mov a, b
0900   03C7 26 64 00      mov b, 100
0901   03CA AE            div a, b
0902   03CB 07 DF 03      call print_number
0903   03CE 11            mov a, b
0904   03CF 26 0A 00      mov b, 10
0905   03D2 AE            div a, b
0906   03D3 07 DF 03      call print_number
0907   03D6 1B            mov al, bl      ; 1's coeff in bl
0908   03D7 07 DF 03      call print_number
0909   03DA FD F1         pop g
0910   03DC E5            pop b
0911   03DD E4            pop a
0912   03DE 09            ret
0913   03DF             
0914   03DF             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
