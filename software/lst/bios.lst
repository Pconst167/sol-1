0923   03E6             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0924   03E6             ; HEX STRING TO BINARY
0925   03E6             ; di = destination address
0926   03E6             ; si = source
0927   03E6             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0928   03E6             _hex_to_int:
0929   03E6             _hex_to_int_L1:
0930   03E6 F6            lodsb          ; load from [SI] to AL
0931   03E7 B9 00         cmp al, 0        ; check if ASCII 0
0932   03E9 C6 F6 03      jz _hex_to_int_ret
0933   03EC 36            mov bh, al
0934   03ED F6            lodsb
0935   03EE 2F            mov bl, al
0936   03EF 07 59 03      call _atoi        ; convert ASCII byte in B to int (to AL)
